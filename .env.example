# Welche Compose-Dateien "docker compose" ohne -f lädt. Nur lokal: So kommen die
# gebündelte Postgres (compose.db.yaml) und MailDev (compose.dev.yaml) mit.
# Im Deployment beide Zeilen weglassen. Dockhand ruft ohnehin per -f
# compose.dockhand.yaml auf, und ein explizites -f schlägt diese Einstellung.
# COMPOSE_PATH_SEPARATOR macht den ":"-Trenner auch unter Windows gültig.
COMPOSE_FILE="compose.yaml:compose.db.yaml:compose.dev.yaml"
COMPOSE_PATH_SEPARATOR=":"

# Host-Port des web-Containers (nur Compose; der Node-Prozess im Container lauscht
# immer auf 3000). In Produktion 8286.
WEB_PORT="3000"
# Host-Port des Directus-Containers (nur Compose; intern immer 8055). Die lokalen
# Defaults von DIRECTUS_PUBLIC_URL und DIRECTUS_ASSET_URL folgen diesem Port.
DIRECTUS_PORT="8055"
# Image-Tag von Directus. Vor einem Sprung Release Notes lesen und Backup ziehen.
DIRECTUS_VERSION="12.2.0"

# Datenbank (nur fuer Directus — die Website selbst spricht keine DB an)
# Zugangsdaten der gebündelten Postgres aus compose.db.yaml — nur lokal.
POSTGRES_USER="root"
POSTGRES_PASSWORD="mysecretpassword"
POSTGRES_DB="directus"
# Im Deployment (ohne compose.db.yaml) Pflicht: eine bestehende Postgres. Mit compose.db.yaml
# wird der Wert überschrieben. compose.prod.yaml baut ihn ohne DIRECTUS_DB_URL aus
# POSTGRES_USER/POSTGRES_PASSWORD, POSTGRES_HOST (Standard "postgres", der Containername
# im Netz pgnet), POSTGRES_PORT (Standard 5432) und POSTGRES_DB (dort Standard "biglemon").
# DIRECTUS_DB_URL="postgresql://user:pass@host:5432/directus"

# SMTP-Versand des Anfrageformulars
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
# Optional: erzwingt implizites TLS. Ohne Angabe: true bei Port 465, sonst STARTTLS.
# SMTP_SECURE="false"
SMTP_USER="anfragen@biglemon.de"
SMTP_PASS=""
# Absender der Mail. Muss beim Postfach des SMTP-Kontos liegen, sonst greift SPF/DMARC.
SMTP_FROM="BigLemon Website <anfragen@biglemon.de>"
# Empfänger der Anfragen. Ohne Angabe: welcome@biglemon.de aus src/lib/data/content.ts
CONTACT_EMAIL="welcome@biglemon.de"

# Directus-Container (compose.yaml)
DIRECTUS_SECRET=""            # openssl rand -base64 32
# Open-Innovation-Grant-Key, Format DXXXX-XXXXX-XXXXX-XXXXX-XXXXC.
# Achtung: Der Key bindet sich beim ersten Start fest an dieses Projekt und an
# PUBLIC_URL. Wird er lokal aktiviert, ist eine der (begrenzten) Aktivierungen
# an http://localhost:8055 vergeben. Für die Produktion daher entweder vorher
# PUBLIC_URL auf die echte Domain setzen oder den Key nur dort eintragen.
# Leer lassen = Core-Tier.
DIRECTUS_LICENSE_KEY=""
DIRECTUS_ADMIN_EMAIL="admin@biglemon.de"
DIRECTUS_ADMIN_PASSWORD=""
# Oeffentliche Adresse des CMS. Bei Pfad-Routing inklusive Praefix,
# z. B. https://biglemon.de/cms — siehe deploy/nginx.conf.example.
DIRECTUS_PUBLIC_URL="http://localhost:8055"
# Hinter einem Reverse Proxy auf "true" setzen; compose.prod.yaml tut das bereits.
# DIRECTUS_TRUST_PROXY="false"

# Anmeldung per Keycloak (nur Produktion, compose.prod.yaml). Im Keycloak-Client muss
# <DIRECTUS_PUBLIC_URL>/auth/login/keycloak/callback als Redirect-URI erlaubt sein.
# AUTH_KEYCLOAK_CLIENT_ID=""
# AUTH_KEYCLOAK_CLIENT_SECRET=""
# AUTH_KEYCLOAK_ISSUER_URL="https://auth.example.de/realms/<realm>"
# Keycloak-Gruppe -> Directus-Rollen-ID. Die IDs sind pro Instanz zufällig und stehen in
# Directus unter Einstellungen -> Rollen.
# AUTH_KEYCLOAK_ROLE_MAPPING='json:{"biglemon-admin":"<uuid>","biglemon-redaktion":"<uuid>"}'
# Dürfen sich Keycloak-Nutzer ohne bestehendes Directus-Konto anmelden? (Standard true)
# AUTH_KEYCLOAK_ALLOW_PUBLIC_REGISTRATION="true"
# Rolle für solche neuen Nutzer, wenn keine Gruppe aus dem Mapping passt (Standard: keine)
# AUTH_KEYCLOAK_DEFAULT_ROLE_ID=""
# "true" schaltet den lokalen Login mit E-Mail und Passwort ab. Standard false, weil
# Admin-Konto und Setup-Skripte ihn brauchen.
# AUTH_DISABLE_DEFAULT="false"

# Directus-Zugriff aus SvelteKit
# SSR spricht Directus intern an — im Compose-Netz http://directus:8055
DIRECTUS_URL="http://localhost:8055"
# URL, die im Browser landet (Bild-URLs) — in Produktion z. B. https://cms.biglemon.de
DIRECTUS_ASSET_URL="http://localhost:8055"
# Optional, nur nötig wenn die Collections nicht öffentlich lesbar sein sollen
DIRECTUS_TOKEN=""
# Sekunden, die Inhalte im Prozess gecacht werden (Standard: 60, im Dev 5)
CMS_CACHE_TTL="60"
